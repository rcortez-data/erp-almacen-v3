# ====== CONFIGURACIÓN DEL SISTEMA ======
# Copiar este archivo a .env y llenar con valores reales

# Ambiente: development, testing, production
FLASK_ENV=development

# Modo debug (True solo en desarrollo)
DEBUG=True
SESSION_COOKIE_SECURE=False

# Clave secreta para sesiones (generar con: python -c "import os; print(os.urandom(32).hex())")
SECRET_KEY=tu-clave-secreta-segura-aqui

# ====== BASE DE DATOS ======
# Fase 3: por ahora el sistema trabaja con SQLite.
# ERP_DATABASE_PATH permite probar otra copia de la base sin tocar almacen.db.
ERP_DB_BACKEND=sqlite
ERP_DATABASE_PATH=./almacen.db

# ====== SEGURIDAD ======
# Contraseña mínima requerida
PASSWORD_MIN_LENGTH=8

# Intentos de login antes de bloquear
MAX_LOGIN_ATTEMPTS=5

# Minutos de timeout después de fallos
LOGIN_TIMEOUT_MINUTES=15

# ====== PERFORMANCE ======
# Tamaño de página en listados
PAGINATION_SIZE=25

# Timeout de caché en segundos
CACHE_TIMEOUT=1800

# Tamaño de lote para procesamiento
BATCH_PROCESS_SIZE=100

# ====== LOGGING ======
LOG_LEVEL=INFO
LOG_FILE=logs/erp_almacen.log

# ====== REPORTES ======
# Tasa de IVA por defecto
DEFAULT_IVA_RATE=0.16

# Zona horaria
REPORT_TIMEZONE=America/Mexico_City

# ====== BACKUP ======
# Habilitar backup automático
ENABLE_AUTO_BACKUP=True

# Días de retención de backups
BACKUP_RETENTION_DAYS=30

# ====== SERVIDOR ======
# Host y puerto
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
