SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
WHATSAPP_NUMBER=5210000000000
SHIPPING_COST=99.00
# Vacío usa SQLite. Ejemplos para producción:
# DATABASE_URL=mysql://usuario:clave@host:3306/base
# DATABASE_URL=postgresql://usuario:clave@host:5432/base
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ventas@example.com
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Configuración del ERP Flask
FLASK_ENV=development
SESSION_COOKIE_SECURE=False
ERP_DB_BACKEND=sqlite
ERP_DATABASE_PATH=./almacen.db
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT_MINUTES=15
PAGINATION_SIZE=25
CACHE_TIMEOUT=1800
BATCH_PROCESS_SIZE=100
LOG_LEVEL=INFO
LOG_FILE=logs/erp_almacen.log
DEFAULT_IVA_RATE=0.16
REPORT_TIMEZONE=America/Mexico_City
ENABLE_AUTO_BACKUP=True
BACKUP_RETENTION_DAYS=30
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
