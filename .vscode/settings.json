{
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/backups_db/**": true,
        "**/flask_session/**": true,
        "**/logs/**": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/__pycache__": true,
        "**/backups_db": true,
        "**/flask_session": true,
        "**/logs": true
    }
}
